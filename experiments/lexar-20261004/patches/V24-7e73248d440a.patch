+static int barrier(bvm *vm) {
+    job *j=current(vm); uint32_t start=now();
+    j->ready=1;
+    while(!jobs[1-j->index].ready) {
+        if((uint32_t)(now()-start)>20000) be_raise(vm,"runtime_error","parallel barrier timeout");
