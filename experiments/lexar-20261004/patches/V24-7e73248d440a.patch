+    while(!_locktry(init_lock)) {}
+    j->stage=2; vm=be_vm_new(); _lockrel(init_lock);
+    if(!vm) { j->status=-101; j->done=1; return; }
+    j->stage=3;
+    be_regfunc(vm,"barrier",barrier); be_regfunc(vm,"progress",progress);
+    be_pushint(vm,401+(int)j->index); be_setglobal(vm,"identity"); be_pop(vm,1);
+    j->stage=4; j->status=be_loadstring(vm,source); j->stage=5;
