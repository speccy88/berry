+/* DIAGNOSTIC DRIVER ONLY: invokes the production coherent Hub bootstrap.
+ * One worker/cache persists across jobs. This is not public spawn/reap proof. */
+typedef struct {
+    p2_child_vm_cog_once_job job;
+    p2_partition *tickets[12];
+    volatile unsigned round, acknowledged;
+    volatile unsigned free_bytes, low_address;
+} coherent_hil_control;
+static void coherent_hil_worker(void *argument)
+{
+    coherent_hil_control *c = (coherent_hil_control *)argument;
+    unsigned i;
+    for (i = 1; i <= 12; ++i) {
+        while (c->round != i) _waitus(1000);
+        p2_child_vm_coherent_entry(&c->job);
+        c->free_bytes = c->job.admission_free;
+        c->low_address = c->job.admission_low;
+        c->acknowledged = i;
+    }
+    for (;;) _waitus(1000);
+}
+static unsigned source_hil_mask(void)
+{
+    unsigned i, mask = 0;
+    for (i = 0; i < 8; ++i) if (_cogchk(i)) mask |= 1u << i;
+    return mask;
+}
+static uint32_t source_hil_now(void)
+{
+    uint32_t t = 0; p2_clock_millis_now(&t); return t;
+}
+int p2_coherent_admission_hil(void)
+{
+    static const char *sources[] = {
+        "def f(x) def recurse(n) if n==0 return x end return recurse(n-1) end return recurse(30) end",
+        "def f(x) return x end",
+        "def f(x) raise 'value_error', 'source-error' end",
+        "def f(x) var s='0123456789abcdef' while true s=s+s end end",
+        "def f(x) return x+19 end",
+        "def f(x) return x end"
+    };
+    coherent_hil_control *c;
+    unsigned char *stack;
+    unsigned i, kind, before, during, after, untouched = 0;
+    int cog, control_lock, failures = 0;
+    uint32_t start;
+    char line[320];
+    p2_serial_init();
+    if (!p2_cog_registry_startup() || !p2_hub_heap_init()) return 1;
+    p2_child_vm_runtime_lock_init();
+    before = source_hil_mask();
+    c = (coherent_hil_control *)p2_hub_calloc(1, sizeof(*c));
+    stack = (unsigned char *)p2_hub_malloc(32768);
+    if (!c || !stack) return 2;
+    control_lock = LOCKNEW;
+    if (control_lock < 0 || p2_child_vm_runtime_lock < 0) return 7;
+    for (i = 0; i < 12; ++i) {
+        c->tickets[i] = (p2_partition *)p2_hub_calloc(1, p2_partition_storage_size());
+        if (!c->tickets[i] || !p2_partition_reserve(c->tickets[i],i+1,262144,
+                P2_PARTITION_CACHE_LINE_BYTES,control_lock,p2_child_vm_runtime_lock)) {
+            p2_serial_puts("COHERENT_ADMISSION_9ab1_RESERVE_FAILED\n"); return 8;
+        }
+    }
+    memset(stack, 0xa5, 32768);
+    cog = p2_catalina_cogstart_C(coherent_hil_worker, c, stack, 32768);
+    during = source_hil_mask();
+    snprintf(line, sizeof(line), "\nCOHERENT_ADMISSION_9ab1_BEGIN main=%d worker=%d before=%x during=%x\n", _cogid(), cog, before, during);
+    p2_serial_puts(line);
+    if (cog < 0) return 3;
+    for (i = 1; i <= 12; ++i) {
+        kind = (i - 1) % 6;
+        memset(&c->job, 0, sizeof(c->job));
+        c->job.bytes = 262144; c->job.slot = 0;
+        c->job.admission = c->tickets[i-1]; c->job.admission_generation = i;
+        if (!p2_partition_offer(c->job.admission,i,cog)) return 9;
+        strcpy(c->job.source, sources[kind]); strcpy(c->job.name, "f");
+        c->job.argc = 1; c->job.arg_type[0] = 1; c->job.arg_int[0] = 76123 + i;
+        if (kind == 1) {
+            c->job.arg_type[0] = 4;
+            strcpy(c->job.arg_string[0], "copied-input-c17d");
+        }
+        if (kind == 5) {
+            c->job.cancel_requested = 1;
+            if (!p2_partition_cancel(c->job.admission,i)) return 10;
+        }
+        start = source_hil_now(); c->round = i;
+        while (c->job.status != 2 && (uint32_t)(source_hil_now() - start) < 45000) _waitus(1000);
+        if (c->job.status != 2) {
+            snprintf(line, sizeof(line), "COHERENT_ADMISSION_9ab1_TIMEOUT round=%u status=%d stage=%d load=%d call=%d\n", i, c->job.status, c->job.vm_new_detail_stage, c->job.load_stage, c->job.call_stage);
+            p2_serial_puts(line);
+            /* Do not kill a possibly lock-owning VM or free its resources. */
+            return 4;
+        }
+        c->job.status = 4;
+        while (c->acknowledged != i && (uint32_t)(source_hil_now() - start) < 47000) _waitus(1000);
+        if (c->acknowledged != i) return 5;
+        if (kind == 0 && !(c->job.call_result == BE_OK && c->job.result_int == 76123 + i)) ++failures;
+        if (kind == 1 && !(c->job.call_result == BE_OK && !strcmp(c->job.result_string, "copied-input-c17d"))) ++failures;
+        if (kind == 2 && c->job.call_result != BE_EXCEPTION) ++failures;
+        if (kind == 3 && c->job.call_result != BE_MALLOC_FAIL) ++failures;
+        if (kind == 4 && !(c->job.call_result == BE_OK && c->job.result_int == 76142 + i)) ++failures;
+        if (kind == 5 && !(c->job.call_result == BE_EXIT && !c->job.child_created && !c->job.partition_ready)) ++failures;
+        if (c->job.child_created != c->job.child_deleted) ++failures;
+        if (!c->job.admission_retired || c->job.admission_free != c->job.admission_initial_free) ++failures;
+        if (kind != 5 && (!c->job.partition_ready || !c->job.selected || !c->job.admission_low)) ++failures;
+        snprintf(line, sizeof(line), "ADMISSION_ROW round=%u kind=%u cog=%d status=%d source=%d result=%d type=%d integer=%ld created=%d deleted=%d free=%u low=%x initial=%u retired=%d elapsed=%lu text=%s\n", i, kind, c->job.cog_id, c->job.status, c->job.source_result, c->job.call_result, c->job.result_type, (long)c->job.result_int, c->job.child_created, c->job.child_deleted, c->free_bytes, c->low_address, (unsigned)c->job.admission_initial_free, c->job.admission_retired, (unsigned long)(source_hil_now()-start), c->job.result_string);
+        p2_serial_puts(line);
+    }
+    _cogstop(cog);
+    p2_xmm_private_cache_release(cog);
+    after = source_hil_mask();
+    while (untouched < 32768 && stack[untouched] == 0xa5) ++untouched;
+    if (after != before || untouched < 64) ++failures;
+    snprintf(line, sizeof(line), "COHERENT_ADMISSION_9ab1_END failures=%d after=%x stack_bytes=32768 untouched_prefix=%u write_extent=%u\n", failures, after, untouched, 32768-untouched);
+    p2_serial_puts(line);
+    /* Heap partition/cache reuse is still unqualified: retain allocations
+     * until reset instead of pretending diagnostic teardown is production. */
+    return failures ? 6 : 0;
+}
