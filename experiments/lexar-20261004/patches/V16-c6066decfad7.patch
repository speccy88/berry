+typedef struct {
+    volatile int stage;
+    volatile unsigned core_mask, library_ticks, calls;
+    bvm_options *nested;
+    bvm *peer;
+} ctor_trace;
+/* DIAGNOSTIC DRIVER ONLY: invokes the production coherent Hub bootstrap.
+ * One worker/cache persists across jobs. This is not public spawn/reap proof. */
+typedef struct {
+    p2_child_vm_cog_once_job job;
+    p2_partition *tickets[14];
+    p2_partition *constructors[4];
+    ctor_trace traces[4];
+    volatile unsigned ctor_go, ctor_done;
+    volatile int ctor_failures, ctor_created, ctor_deleted;
+    volatile size_t ctor_low[4], ctor_initial[4], ctor_final[4];
+    volatile int ctor_policy[4], ctor_value[4];
+    int execution_lock;
+    volatile unsigned round, acknowledged;
+    volatile unsigned free_bytes, low_address;
+} coherent_hil_control;
+/* Diagnostic only: nested real Berry constructors on the private-cache worker. */
+static void ctor_observe(void *context, int stage)
+{
+    ctor_trace *t = context;
+    t->stage = stage;
+    ++t->calls;
+    if (stage >= 1 && stage <= 9) t->core_mask |= 1u << stage;
+    if (stage >= 20 && stage <= 40) ++t->library_ticks;
+    if (stage == 4 && t->nested) {
+        bvm_options *options = t->nested;
+        t->nested = NULL;
+        t->peer = be_vm_new_with_options(options);
+    }
+}
+static void ctor_run_value(bvm *vm, void *data)
+{
+    int *value = data;
+    int rc;
+    /* P2 custom-precompiled registration uses globals, not host builtins. */
+    if (!be_global_count(vm)) be_loadlibs(vm);
+    rc = be_loadstring(vm, *value == 71 ? "var private_value=71 return private_value" :
+                                      "var private_value=29 return private_value");
+    if (rc == BE_OK) rc = be_pcall(vm, 0);
+    if (rc != BE_OK) be_throw(vm, rc);
+    *value = (int)be_toint(vm, -1);
+    be_pop(vm, be_top(vm));
+}
+static void ctor_worker_check(coherent_hil_control *s)
+{
+    int pair, i;
+    while (!s->ctor_go) _waitus(100);
+    while (LOCKSET(s->execution_lock)) _waitus(100);
+    for (i=0; i<4; ++i) {
+        if (p2_partition_claim(s->constructors[i], 101+i) != 1) {
+            ++s->ctor_failures;
+            LOCKCLR(s->execution_lock); s->ctor_done=1; return;
+        }
+        s->ctor_low[i]=p2_partition_low_address(s->constructors[i], 101+i);
+        s->ctor_initial[i]=p2_partition_free_bytes(s->constructors[i], 101+i);
+    }
+    for (pair=0; pair<2; ++pair) {
+        int a=pair*2, b=a+1, va=71, vb=29;
+        unsigned ac, bc;
+        bvm *outer, *inner;
+        bvm_options oa={0}, ob={0};
+        oa.allocator=ob.allocator=p2_partition_realloc;
+        oa.allocator_context=s->constructors[a]; ob.allocator_context=s->constructors[b];
+        oa.skip_loadlibs=pair; ob.skip_loadlibs=!pair;
+        oa.progress=ob.progress=ctor_observe;
+        oa.progress_context=&s->traces[a]; ob.progress_context=&s->traces[b];
+        s->traces[a].nested=&ob;
+        outer=be_vm_new_with_options(&oa); inner=s->traces[a].peer;
+        s->traces[a].peer=NULL; s->traces[a].nested=NULL;
+        s->ctor_created+=(outer!=NULL)+(inner!=NULL);
+        if (outer && inner) {
+            s->ctor_policy[a]=(be_global_count(outer)==0)==pair;
+            s->ctor_policy[b]=(be_global_count(inner)==0)==!pair;
+            ac=s->traces[a].calls; bc=s->traces[b].calls;
+            if (be_execprotected(outer, ctor_run_value, &va)!=BE_OK || va!=71) ++s->ctor_failures;
+            if (be_execprotected(inner, ctor_run_value, &vb)!=BE_OK || vb!=29) ++s->ctor_failures;
+            s->ctor_value[a]=va;
+            be_vm_delete(outer); outer=NULL; ++s->ctor_deleted;
+            if (!be_getglobal(inner, "private_value") || be_toint(inner,-1)!=29) ++s->ctor_failures;
+            else s->ctor_value[b]=(int)be_toint(inner,-1);
+            be_pop(inner,1);
+            be_vm_delete(inner); inner=NULL; ++s->ctor_deleted;
+            if (s->traces[a].calls!=ac || s->traces[b].calls!=bc) ++s->ctor_failures;
+        } else ++s->ctor_failures;
+        if (outer) {be_vm_delete(outer); ++s->ctor_deleted;}
+        if (inner) {be_vm_delete(inner); ++s->ctor_deleted;}
+    }
+    for (i=0; i<4; ++i) {
+        s->ctor_final[i]=p2_partition_free_bytes(s->constructors[i], 101+i);
+        if (s->ctor_final[i]!=s->ctor_initial[i] || !s->ctor_policy[i] ||
+            s->traces[i].stage!=9 || s->traces[i].core_mask!=0x3fe) ++s->ctor_failures;
+        if (!p2_partition_retire(s->constructors[i],101+i)) ++s->ctor_failures;
+    }
+    LOCKCLR(s->execution_lock);
+    s->ctor_done=1;
+}
+
+static void coherent_hil_worker(void *argument)
+{
+    coherent_hil_control *c = (coherent_hil_control *)argument;
+    unsigned i;
+    ctor_worker_check(c);
+    for (i = 1; i <= 14; ++i) {
+        while (c->round != i) _waitus(1000);
+        p2_child_vm_coherent_entry(&c->job);
+        c->free_bytes = c->job.admission_free;
+        c->low_address = c->job.admission_low;
+        c->acknowledged = i;
+    }
+    for (;;) _waitus(1000);
+}
+static unsigned source_hil_mask(void)
+{
+    unsigned i, mask = 0;
+    for (i = 0; i < 8; ++i) if (_cogchk(i)) mask |= 1u << i;
+    return mask;
+}
+static uint32_t source_hil_now(void)
+{
+    uint32_t t = 0; p2_clock_millis_now(&t); return t;
