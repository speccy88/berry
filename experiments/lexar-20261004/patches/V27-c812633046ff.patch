+void p2_startup_status_tick(int stage) { (void)stage; }
+extern int p2_catalina_cogstart_C(void (*entry)(void *), void *argument, void *stack, int bytes);
+typedef struct job {
+    volatile unsigned stage, ready, done;
+    volatile int cog, status, oom, recovery;
+    volatile long value;
+    unsigned index;
+} job;
+static job *jobs;
+static int init_lock;
+static uint32_t now(void) { uint32_t ms=0; p2_clock_millis_now(&ms); return ms; }
+static int barrier(bvm *vm) {
+    int id = _cogid();
+    unsigned i;
+    uint32_t start = now();
+    for(i=0;i<2;i++) if(jobs[i].cog==id) break;
+    if(i==2) be_raise(vm,"runtime_error","unknown worker");
+    jobs[i].ready=1;
+    while(!jobs[1-i].ready) {
+        if((uint32_t)(now()-start)>15000) be_raise(vm,"runtime_error","parallel barrier timeout");
+        _waitms(1);
+    }
+    be_pushnil(vm); be_return(vm);
+}
+static void worker(void *arg) {
+    job *j = arg;
+    bvm *vm;
+    const char *source = "barrier() var kept=[] for i:0..511 kept.push({'i':i,'owner':identity}) end import gc gc.collect() var sum=0 for m:kept assert(m['owner']==identity) sum+=m['i'] end return sum+identity";
+    j->cog=_cogid(); j->stage=1;
+    if(!p2_heap_vm_partition_select(j->index)) { j->status=-100; j->done=1; for(;;)_waitms(1000); }
+    /* Short initialization-only lock protects legacy creation diagnostics;
+     * it is released before any parser, workload or barrier executes. */
+    while(!_locktry(init_lock)) {}
+    j->stage=2;
+    vm=be_vm_new();
+    _lockrel(init_lock);
+    if(!vm) { j->status=-101; j->done=1; for(;;)_waitms(1000); }
+    j->stage=3;
+    be_regfunc(vm,"barrier",barrier);
+    be_pushint(vm, 401+(int)j->index); be_setglobal(vm,"identity"); be_pop(vm,1);
+    j->stage=4;
+    j->status=be_loadstring(vm,source);
+    j->stage=5;
+    if(j->status==BE_OK) j->status=be_pcall(vm,0);
+    j->stage=6;
+    if(j->status==BE_OK && be_isint(vm,-1)) j->value=be_toint(vm,-1);
+    be_pop(vm,be_top(vm));
+    j->oom=be_loadstring(vm,"var retained=[] while true retained.push(bytes(1024)) end");
+    if(j->oom==BE_OK) j->oom=be_pcall(vm,0);
+    be_pop(vm,be_top(vm));
+    j->stage=7;
+    be_gc_collect(vm);
+    j->recovery=be_loadstring(vm,"import gc gc.collect() return identity");
+    if(j->recovery==BE_OK) j->recovery=be_pcall(vm,0);
+    if(j->recovery==BE_OK && (!be_isint(vm,-1)||be_toint(vm,-1)!=401+(int)j->index)) j->recovery=-102;
+    be_pop(vm,be_top(vm));
+    j->stage=8;
+    be_vm_delete(vm);
+    p2_heap_vm_partition_clear_current();
+    j->stage=9; j->done=1;
+    for(;;) _waitms(1000);
+}
