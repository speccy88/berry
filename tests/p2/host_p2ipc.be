var ch = p2.channel.new(2)
var ch_info = ch.info()
assert(ch_info["kind"] == "Channel")
assert(ch._task_kind == "p2ipc_channel")
assert(ch_info["depth"] == 2)
assert(ch_info["size"] == 0)
assert(ch_info["free"] == 2)
assert(ch_info["hardware_lock"])
assert(ch_info["lock_id"] >= 0)
ch_info["size"] = 99
assert(ch.info()["size"] == 0)
assert(ch.send("a"))
assert(ch.send("b"))
assert(!ch.send("c"))
assert(ch.size() == 2)
assert(ch.free() == 0)
assert(ch.info()["size"] == 2)
assert(ch.info()["free"] == 0)
assert(ch.recv() == "a")
assert(ch.recv() == "b")
assert(ch.recv() == nil)
var ch_nil_send = ch.send_result(nil)
assert(ch_nil_send["ok"])
assert(ch_nil_send["sent"])
assert(ch_nil_send["size"] == 1)
assert(ch_nil_send["free"] == 1)
assert(ch_nil_send["payload_contract"])
assert(ch_nil_send["current_vm_reference"])
assert(!ch_nil_send["serialized"])
assert(!ch_nil_send["ownership_transfer"])
assert(ch_nil_send["payload_type"] == "nil")
assert(ch_nil_send["serialization_policy"] == "unsupported_current_vm_references_only")
assert(ch_nil_send["ownership_policy"] == "caller_keeps_current_vm_object_ownership")
var ch_nil_recv = ch.recv_result()
assert(ch_nil_recv["ok"])
assert(ch_nil_recv["found"])
assert(ch_nil_recv["value"] == nil)
assert(ch_nil_recv["size"] == 0)
assert(ch_nil_recv["free"] == 2)
assert(ch_nil_recv["payload_contract"])
assert(ch_nil_recv["current_vm_reference"])
assert(ch_nil_recv["payload_type"] == "nil")
var ch_empty_recv = ch.recv_result()
assert(ch_empty_recv["ok"])
assert(!ch_empty_recv["found"])
assert(ch_empty_recv["value"] == nil)
assert(ch_empty_recv["payload_contract"])
assert(!ch_empty_recv["current_vm_reference"])
assert(ch_empty_recv["payload_type"] == nil)
assert(ch.send_result("x")["ok"])
assert(ch.send_result("y")["ok"])
var ch_full_send = ch.send_result("z")
assert(!ch_full_send["ok"])
assert(!ch_full_send["sent"])
assert(ch_full_send["error"] == "full")
assert(ch_full_send["size"] == 2)
var ch_snapshot = ch.snapshot_result()
assert(ch_snapshot["ok"])
assert(ch_snapshot["size"] == 2)
assert(ch_snapshot["free"] == 0)
assert(ch_snapshot["depth"] == 2)
assert(ch_snapshot["items"].size() == 2)
assert(ch_snapshot["items"][0] == "x")
assert(ch_snapshot["items"][1] == "y")
assert(ch_snapshot["payload_contract"])
assert(ch_snapshot["current_vm_reference"])
assert(!ch_snapshot["serialized"])
assert(!ch_snapshot["ownership_transfer"])
ch_snapshot["items"].clear()
assert(ch.size() == 2)
assert(ch.recv() == "x")
assert(ch.recv() == "y")
var ch_empty_snapshot = ch.snapshot_result()
assert(ch_empty_snapshot["ok"])
assert(ch_empty_snapshot["items"].size() == 0)
assert(!ch_empty_snapshot["current_vm_reference"])
assert(ch.send("keep"))
assert(ch.send(nil))
var ch_clear = ch.clear_result()
assert(ch_clear["ok"])
assert(ch_clear["cleared"])
assert(ch_clear["released_payloads"] == 2)
assert(ch_clear["size"] == 0)
assert(ch_clear["free"] == 2)
assert(ch.size() == 0)
assert(ch.free() == 2)
assert(ch.recv() == nil)
assert(ch.send("reuse"))
assert(ch.recv() == "reuse")
var ch_clear_empty = ch.clear_result()
assert(ch_clear_empty["ok"])
assert(ch_clear_empty["released_payloads"] == 0)
var ch_close = ch.close_result()
assert(ch_close["ok"])
assert(ch_close["closed"])
assert(!ch_close["was_closed"])
assert(ch_close["depth"] == 2)
assert(ch_close["size"] == 0)
assert(ch_close["free"] == 2)
assert(ch_close["previous_size"] == 0)
assert(ch_close["previous_free"] == 2)
assert(ch_close["released_payloads"] == 0)
assert(ch_close["hardware_lock"])
assert(ch_close["lock_id"] == ch_info["lock_id"])
assert(ch.info()["closed"])
assert(ch.info()["lock_id"] == -1)
assert(!ch.send("after-close"))
assert(ch.recv() == nil)
var ch_closed_send = ch.send_result("after-close")
assert(!ch_closed_send["ok"])
assert(!ch_closed_send["sent"])
assert(ch_closed_send["error"] == "closed")
var ch_closed_recv = ch.recv_result()
assert(!ch_closed_recv["ok"])
assert(!ch_closed_recv["found"])
assert(ch_closed_recv["error"] == "closed")
var ch_closed_snapshot = ch.snapshot_result()
assert(!ch_closed_snapshot["ok"])
assert(ch_closed_snapshot["error"] == "closed")
assert(ch_closed_snapshot["items"].size() == 0)
assert(!ch.clear())
var ch_closed_clear = ch.clear_result()
assert(!ch_closed_clear["ok"])
assert(!ch_closed_clear["cleared"])
assert(ch_closed_clear["error"] == "closed")
var ch_close_again = ch.close_result()
assert(ch_close_again["ok"])
assert(ch_close_again["was_closed"])
assert(ch_close_again["lock_id"] == -1)
assert(!ch_close_again["hardware_lock"])

