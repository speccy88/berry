import introspect

var p2 = module("p2")
var lock = module("p2.lock")
var lock_state = {}
var next_lock = 0

lock.new = def()
    var id = next_lock
    next_lock += 1
    lock_state[id] = false
    return id
end
lock.("try") = def(id)
    if lock_state[id]
        return 0
    end
    lock_state[id] = true
    return 1
end
lock.release = def(id)
    lock_state[id] = false
end
lock.ret = def(id)
    lock_state.remove(id)
end

p2.lock = lock
introspect.setmodule("p2", p2)

var p2ipc = run_file("modules/p2ipc.be")
assert(type(p2ipc) == "module")
assert(type(p2.channel) == "module")
assert(type(p2.mailbox) == "module")
assert(type(p2.shared) == "module")
assert(type(p2.mutex) == "module")
