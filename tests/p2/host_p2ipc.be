var buf = p2.shared.Buffer(4)
var buf_info = buf.info()
assert(buf_info["kind"] == "Buffer")
assert(buf_info["size"] == 4)
buf_info["size"] = 99
assert(buf.info()["size"] == 4)
assert(buf.size() == 4)
assert(buf.aslist() == [0, 0, 0, 0])
assert(buf.write(0, 17))
assert(buf.write(3, 255))
assert(!buf.write(4, 1))
assert(!buf.write(1, 256))
assert(buf.read(0) == 17)
assert(buf.read(3) == 255)
assert(buf.read(4) == nil)
assert(buf.fill(7))
assert(buf.aslist() == [7, 7, 7, 7])
var snap = buf.aslist()
snap[0] = 99
assert(buf.read(0) == 7)
assert(!buf.write(-1, 1))
assert(!buf.write(0, -1))
assert(!buf.write(nil, 1))
assert(!buf.write("bad", 1))
assert(!buf.write(0, nil))
assert(!buf.write(0, "bad"))
assert(!buf.fill(256))
assert(!buf.fill(nil))
assert(!buf.fill("bad"))
assert(buf.aslist() == [7, 7, 7, 7])
var buf_write = buf.write_result(1, 33)
assert(buf_write["ok"])
assert(buf_write["written"])
var buf_read = buf.read_result(1)
assert(buf_read["ok"])
assert(buf_read["found"])
assert(buf_read["value"] == 33)
var buf_bad_offset = buf.read_result("bad")
assert(!buf_bad_offset["ok"])
assert(buf_bad_offset["error"] == "invalid_offset")
var buf_oob = buf.write_result(4, 1)
assert(!buf_oob["ok"])
assert(buf_oob["error"] == "offset_out_of_range")
var buf_bad_value = buf.write_result(0, 256)
assert(!buf_bad_value["ok"])
assert(buf_bad_value["error"] == "value_out_of_range")
var buf_bad_type = buf.fill_result(nil)
assert(!buf_bad_type["ok"])
assert(buf_bad_type["error"] == "invalid_value")
var buf_fill = buf.fill_result(5)
assert(buf_fill["ok"])
assert(buf_fill["filled"])
assert(buf.aslist() == [5, 5, 5, 5])
assert(buf.clear())
assert(buf.aslist() == [0, 0, 0, 0])
assert(buf.fill(9))
var buf_clear = buf.clear_result()
assert(buf_clear["ok"])
assert(buf_clear["cleared"])
assert(buf_clear["size"] == 4)
assert(buf_clear["released_bytes"] == 4)
assert(buf.aslist() == [0, 0, 0, 0])

var empty_buf = p2.shared.Buffer(-3)
assert(empty_buf.size() == 0)
assert(empty_buf.read(0) == nil)
assert(!empty_buf.write(0, 1))
assert(empty_buf.aslist() == [])
var empty_buf_clear = empty_buf.clear_result()
assert(empty_buf_clear["ok"])
assert(empty_buf_clear["size"] == 0)
assert(empty_buf_clear["released_bytes"] == 0)

var invalid_buf = p2.shared.Buffer("bad")
assert(invalid_buf.size() == 0)
assert(invalid_buf.aslist() == [])

var m = p2.mutex.new()
assert(m.id() >= 0)
var m_info = m.info()
assert(m_info["kind"] == "Mutex")
assert(m_info["hardware"])
assert(m_info["lock_id"] == m.id())
var m_unlock_unlocked = m.unlock_result()
assert(!m_unlock_unlocked["ok"])
assert(!m_unlock_unlocked["unlocked"])
assert(m_unlock_unlocked["error"] == "not_locked")
var m_lock_result = m.lock_result()
assert(m_lock_result["ok"])
assert(m_lock_result["locked"])
assert(m_lock_result["hardware"])
var m_lock_busy = m.lock_result()
assert(!m_lock_busy["ok"])
assert(!m_lock_busy["locked"])
assert(m_lock_busy["error"] == "busy")
var m_unlock_result = m.unlock_result()
assert(m_unlock_result["ok"])
assert(m_unlock_result["unlocked"])
assert(m.lock())
assert(!m.lock())
assert(m.unlock())
var m_close_result = m.close_result()
assert(m_close_result["ok"])
assert(m_close_result["closed"])
assert(!m_close_result["was_closed"])
assert(m_close_result["hardware"])
assert(m_close_result["lock_id"] == m_info["lock_id"])
assert(m.info()["closed"])
assert(m.id() == -1)
assert(!m.lock())
assert(!m.unlock())
var m_closed_lock = m.lock_result()
assert(!m_closed_lock["ok"])
assert(m_closed_lock["error"] == "closed")
var m_closed_unlock = m.unlock_result()
assert(!m_closed_unlock["ok"])
assert(m_closed_unlock["error"] == "closed")
var m_closed_again = m.close_result()
assert(m_closed_again["ok"])
assert(m_closed_again["closed"])
assert(m_closed_again["was_closed"])
assert(m.close())

var blocked_ch = p2.channel.new(1)
assert(blocked_ch.mutex.lock())
assert(!blocked_ch.send("x"))
assert(!blocked_ch.clear())
var blocked_clear = blocked_ch.clear_result()
assert(!blocked_clear["ok"])
assert(!blocked_clear["cleared"])
assert(blocked_clear["error"] == "lock_busy")
var blocked_send = blocked_ch.send_result("x")
assert(!blocked_send["ok"])
assert(!blocked_send["sent"])
assert(blocked_send["error"] == "lock_busy")
assert(blocked_ch.recv() == nil)
var blocked_recv = blocked_ch.recv_result()
assert(!blocked_recv["ok"])
assert(!blocked_recv["found"])
assert(blocked_recv["error"] == "lock_busy")
assert(blocked_ch.mutex.unlock())
assert(blocked_ch.send("x"))
assert(blocked_ch.recv() == "x")
assert(blocked_ch.close())

var blocked_mb = p2.mailbox.new()
assert(blocked_mb.mutex.lock())
assert(!blocked_mb.put("x"))
assert(!blocked_mb.clear())
var blocked_mb_clear = blocked_mb.clear_result()
assert(!blocked_mb_clear["ok"])
assert(!blocked_mb_clear["cleared"])
assert(blocked_mb_clear["error"] == "lock_busy")
assert(blocked_mb.mutex.unlock())
assert(blocked_mb.put("x"))
assert(blocked_mb.clear())
assert(!blocked_mb.ready())
assert(blocked_mb.close())

lock.new = def()
    return -1
end
var p2ipc_alloc_fail = run_file("modules/p2ipc.be")
assert(type(p2ipc_alloc_fail) == "module")
var fallback_alloc = p2.mutex.new()
assert(fallback_alloc.id() == -1)
var fallback_alloc_info = fallback_alloc.info()
assert(fallback_alloc_info["kind"] == "Mutex")
assert(!fallback_alloc_info["hardware"])
assert(!fallback_alloc_info["locked"])
var fallback_alloc_unlocked = fallback_alloc.unlock_result()
assert(!fallback_alloc_unlocked["ok"])
assert(fallback_alloc_unlocked["error"] == "not_locked")
var fallback_alloc_lock = fallback_alloc.lock_result()
assert(fallback_alloc_lock["ok"])
assert(fallback_alloc_lock["locked"])
assert(!fallback_alloc_lock["hardware"])
var fallback_alloc_busy = fallback_alloc.lock_result()
assert(!fallback_alloc_busy["ok"])
assert(fallback_alloc_busy["error"] == "busy")
var fallback_alloc_unlock = fallback_alloc.unlock_result()
assert(fallback_alloc_unlock["ok"])
assert(fallback_alloc_unlock["unlocked"])
assert(fallback_alloc.lock())
assert(fallback_alloc.info()["locked"])
assert(!fallback_alloc.lock())
assert(fallback_alloc.unlock())
assert(!fallback_alloc.unlock())
assert(fallback_alloc.close())
assert(fallback_alloc.info()["closed"])
assert(!fallback_alloc.lock())
assert(!fallback_alloc.unlock())
assert(fallback_alloc.lock_result()["error"] == "closed")
assert(fallback_alloc.unlock_result()["error"] == "closed")
assert(fallback_alloc.close())

p2.lock = nil
var p2ipc_fallback = run_file("modules/p2ipc.be")
assert(type(p2ipc_fallback) == "module")
assert(!p2ipc_fallback.capabilities()["hardware_lock_backend_available"])
assert(p2ipc_fallback.capability("fallback_mutex"))
assert(!p2ipc_fallback.contract()["hardware_lock_backend_available"])
var fallback = p2.mutex.new()
assert(fallback.id() == -1)
var fallback_close = fallback.close_result()
assert(fallback_close["ok"])
assert(fallback_close["closed"])
assert(!fallback_close["was_closed"])
assert(!fallback_close["hardware"])
assert(fallback_close["lock_id"] == -1)
assert(fallback.lock_result()["error"] == "closed")
var fallback_recheck = fallback.close_result()
assert(fallback_recheck["was_closed"])

fallback = p2.mutex.new()
assert(fallback.lock())
assert(!fallback.lock())
assert(fallback.unlock())
assert(!fallback.unlock())
assert(fallback.close())
assert(fallback.info()["closed"])
assert(!fallback.lock())
assert(!fallback.unlock())
assert(fallback.close())

var fallback_ch = p2.channel.new(1)
var fallback_ch_info = fallback_ch.info()
assert(fallback_ch_info["kind"] == "Channel")
assert(!fallback_ch_info["hardware_lock"])
assert(fallback_ch_info["lock_id"] == -1)
assert(fallback_ch.mutex.lock())
assert(!fallback_ch.send("blocked"))
assert(fallback_ch.recv() == nil)
assert(fallback_ch.mutex.unlock())
assert(fallback_ch.send("ok"))
assert(fallback_ch.recv() == "ok")
assert(fallback_ch.close())
assert(fallback_ch.info()["closed"])
assert(!fallback_ch.send("after-close"))
assert(fallback_ch.send_result("after-close")["error"] == "closed")
