assert(mb.get() == "reuse")
var mb_clear_empty = mb.clear_result()
assert(mb_clear_empty["ok"])
assert(!mb_clear_empty["released_payload"])
var mb_close = mb.close_result()
assert(mb_close["ok"])
assert(mb_close["closed"])
assert(!mb_close["was_closed"])
assert(!mb_close["ready"])
assert(!mb_close["previous_ready"])
assert(!mb_close["released_payload"])
assert(mb_close["hardware_lock"])
assert(mb.info()["closed"])
assert(mb.info()["lock_id"] == -1)
assert(!mb.put("after-close"))
assert(mb.get() == nil)
var mb_closed_put = mb.put_result("after-close")
assert(!mb_closed_put["ok"])
assert(!mb_closed_put["stored"])
assert(mb_closed_put["error"] == "closed")
var mb_closed_get = mb.get_result()
assert(!mb_closed_get["ok"])
assert(!mb_closed_get["found"])
assert(mb_closed_get["error"] == "closed")
var mb_closed_peek = mb.peek_result()
