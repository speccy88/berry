assert(mb_nil_get["payload_type"] == "nil")
var mb_empty_get = mb.get_result()
assert(mb_empty_get["ok"])
assert(!mb_empty_get["found"])
assert(mb_empty_get["value"] == nil)
assert(mb.put("keep"))
var mb_peek = mb.peek_result()
assert(mb_peek["ok"])
assert(mb_peek["found"])
assert(mb_peek["value"] == "keep")
assert(mb.ready())
var mb_clear = mb.clear_result()
assert(mb_clear["ok"])
assert(mb_clear["cleared"])
assert(mb_clear["released_payload"])
assert(!mb_clear["ready"])
assert(!mb.ready())
assert(mb.get() == nil)
