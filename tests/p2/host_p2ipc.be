assert(mb_info["hardware_lock"])
mb_info["ready"] = true
assert(!mb.info()["ready"])
assert(!mb.ready())
assert(mb.put(42))
assert(mb.ready())
assert(mb.info()["ready"])
assert(!mb.put(43))
assert(mb.get() == 42)
assert(mb.get() == nil)
var mb_nil_put = mb.put_result(nil)
