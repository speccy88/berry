var import_ipc_attention = p2ipc.attention_policy()
assert(import_ipc_attention["bounded_attention_wait"])
assert(!import_ipc_attention["cross_cog_wakeup"])
assert(!import_ipc_attention["channel_wakeup"])
assert(!import_ipc_attention["mailbox_wakeup"])
var import_ipc_self_test = p2ipc.self_test_result(1)
assert(import_ipc_self_test["ok"])
assert(import_ipc_self_test["iterations"] == 1)
assert(import_ipc_self_test["failure_count"] == 0)
assert(p2ipc.capability("missing") == nil)
var import_ch = p2ipc.channel.new(1)
assert(type(import_ch.clear_result) == "function")
var import_send = import_ch.send_result("x")
assert(import_send["ok"])
assert(import_send["payload_contract"])
assert(import_send["current_vm_reference"])
assert(!import_send["serialized"])
assert(!import_send["ownership_transfer"])
assert(type(import_ch.snapshot_result) == "function")
var import_snapshot = import_ch.snapshot_result()
assert(import_snapshot["ok"])
assert(import_snapshot["items"].size() == 1)
assert(import_snapshot["items"][0] == "x")
assert(import_snapshot["payload_contract"])
assert(import_ch.size() == 1)
assert(import_ch.clear_result()["released_payloads"] == 1)
assert(type(import_ch.close_result) == "function")
assert(import_ch.close_result()["ok"])
var import_mb = p2ipc.mailbox.new()
assert(type(import_mb.clear_result) == "function")
var import_put = import_mb.put_result("x")
assert(import_put["ok"])
assert(import_put["payload_contract"])
assert(import_put["current_vm_reference"])
assert(import_put["ownership_policy"] == "caller_keeps_current_vm_object_ownership")
assert(type(import_mb.peek_result) == "function")
var import_peek = import_mb.peek_result()
assert(import_peek["ok"])
assert(import_peek["found"])
assert(import_peek["value"] == "x")
assert(import_mb.ready())
assert(import_mb.clear_result()["released_payload"])
assert(type(import_mb.close_result) == "function")
assert(import_mb.close_result()["ok"])
var import_buf = p2ipc.shared.Buffer(2)
assert(type(import_buf.clear_result) == "function")
assert(import_buf.fill(7))
assert(import_buf.clear_result()["released_bytes"] == 2)

