assert(!async_buffer_policy["supported"])
assert(async_buffer_policy["status"] == "unsupported")
assert(async_buffer_policy["policy"] == "unsupported_no_fifo_buffer")
assert(async_buffer_policy["safe_receive_helpers"].find("read_available_results") >= 0)
assert(async_buffer_policy["safe_receive_helpers"].find("read_available") >= 0)
var adc_dac_delta_policy = p2smart.adc_dac_delta_policy()
assert(!adc_dac_delta_policy["supported"])
assert(adc_dac_delta_policy["status"] == "unverified")
assert(adc_dac_delta_policy["policy"] == "unverified_no_calibrated_threshold")
