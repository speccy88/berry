assert(p2smart.audit()["ok"])
assert(p2smart.audit()["missing_capability_keys"].size() == 0)
assert(p2smart.audit()["jumper_pair_checks_ok"])
assert(p2smart.audit_problems().size() == 0)
var p2smart_verified = p2smart.items_by_status("verified")
var p2smart_found_sync_result_diag = false
var p2smart_found_sync_transfer_diag = false
for name : p2smart_verified
    if name == "sync_serial_result_diagnostics"
        p2smart_found_sync_result_diag = true
    end
    if name == "sync_serial_transfer_diagnostics"
        p2smart_found_sync_transfer_diag = true
    end
end
assert(p2smart_found_sync_result_diag)
assert(p2smart_found_sync_transfer_diag)

import task
assert(type(task) == "module")
var task_max = task.info()["max_tasks"]
assert(task_max == 16 || task_max == 32)
assert(task.capabilities()["cooperative"])
assert(task.capabilities()["spin"])
assert(task.capabilities()["event_diagnostics"])
assert(task.capabilities()["self_test_result"])
assert(task.capabilities()["self_test_policy"] == "bounded_current_vm_cleanup_diagnostic")
assert(!task.capabilities()["preemptive"])
assert(type(task.capability) == "function")
if type(task.contract) == "function"
    var task_contract = task.contract()
    assert(task_contract["scheduler_policy"] == "current_vm_callback_step")
    assert(task_contract["max_tasks"] == task_max)
    assert(task_contract["sharing_policy"] == "current_vm_objects_only")
    assert(!task_contract["preemptive"])
    assert(!task_contract["cross_vm_serialization"])
end
if type(task.required_capability_keys) == "function"
    assert(task.required_capability_keys().find("scheduler_policy") >= 0)
    assert(task.required_capability_keys().find("spin2_lifecycle_names") >= 0)
    assert(task.required_capability_keys().find("self_test_result") >= 0)
end
if type(task.required_contract_keys) == "function"
    assert(task.required_contract_keys().find("sharing_policy") >= 0)
    assert(task.required_contract_keys().find("cross_cog_wakeup") >= 0)
end
assert(type(task.primitive_capability) == "function")
assert(task.capability("cooperative"))
assert(task.capability("self_test_result"))
assert(task.capability("self_test_policy") == "bounded_current_vm_cleanup_diagnostic")
assert(task.capability("preemptive") == false)
assert(task.capability("max_tasks") == task_max)
assert(task.capability("missing") == nil)
if type(task.required_primitive_capability_keys) == "function"
    assert(task.required_primitive_capability_keys().find("queue_get_result") >= 0)
    assert(task.required_primitive_capability_keys().find("timer_remaining_result") >= 0)
end
assert(task.primitive_capability("queue_get_result"))
assert(task.primitive_capability("timer_restart_result"))
assert(task.primitive_capability("timer_remaining_result"))
assert(task.primitive_capability("missing") == nil)
assert(type(task.self_test_result) == "function")
var import_task_self_test = task.self_test_result(1)
assert(import_task_self_test["ok"])
assert(import_task_self_test["iterations"] == 1)
assert(import_task_self_test["failure_count"] == 0)
assert(import_task_self_test["active_after"] == 0)
assert(import_task_self_test["events_after"] == 0)

import wifi
assert(type(wifi) == "module")
assert(type(wifi.capabilities) == "function")
assert(type(wifi.capability) == "function")
assert(type(wifi.default_config) == "function")
assert(type(wifi.audit) == "function")
assert(type(wifi.audit_problems) == "function")
assert(type(wifi.audit_ok) == "function")
assert(wifi.STATUS[255] == "no_shield")
assert(wifi.capability("transport") == "spi")
assert(wifi.capability("hardware") == "wifinina_airlift")
assert(wifi.capability("hardware_deferred"))
assert(wifi.capability("request_requires_init"))
assert(wifi.capability("import_init_noop"))
assert(wifi.capability("default_config"))
assert(wifi.capability("audit"))
assert(wifi.capability("missing") == nil)
assert(type(wifi.required_capability_keys) == "function")
assert(wifi.required_capability_keys().find("transport") >= 0)
assert(wifi.required_capability_keys().find("audit_policy") >= 0)
var wifi_cfg = wifi.default_config()
assert(wifi_cfg["sck"] == 16)
assert(wifi_cfg["mosi"] == 17)
assert(wifi_cfg["miso"] == 18)
assert(wifi_cfg["cs"] == 19)
assert(wifi_cfg["busy"] == 20)
assert(wifi_cfg["reset"] == 21)
assert(wifi_cfg["irq"] == 22)
assert(wifi_cfg["khz"] == 1000)
assert(wifi_cfg["mode"] == 0)
wifi_cfg["sck"] = 99
assert(wifi.default_config()["sck"] == 16)
var wifi_audit = wifi.audit()
assert(wifi_audit["ok"])
assert(wifi_audit["problem_count"] == 0)
assert(wifi_audit["problems"].size() == 0)
assert(wifi_audit["missing_capability_keys"].size() == 0)
assert(wifi_audit["transport"] == "spi")
assert(wifi_audit["hardware_deferred"])
assert(wifi_audit["request_requires_init"])
assert(wifi_audit["import_init_noop"])
assert(wifi_audit["audit_policy"] == "metadata_only_no_spi_transaction")
wifi_audit["problems"].push("mutation_probe")
assert(wifi.audit_problems().size() == 0)
assert(wifi.audit_ok())

