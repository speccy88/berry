assert(isinstance(p2smart.names_by_status("verified"), list))
assert(p2smart.names_by_status("verified").find("adc_dac_sampled_probe") >= 0)
assert(p2smart.names_by_status("verified").find("dac_variant_adc_sampled_probe") >= 0)
assert(p2smart.names_by_status("diagnostic").find("adc_variant_dac_sampled_probe") >= 0)
assert(p2smart.names_by_status("diagnostic").find("adc_dac_variants_sampled_probe") >= 0)
